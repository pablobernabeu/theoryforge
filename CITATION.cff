cff-version: 1.2.0
message: "If you use theoryforge, please cite it as below."
title: "theoryforge: Systematic theory development"
abstract: "A rigorous, reproducible workflow for building, developing and testing scientific theories, delivered as twin, feature-parity R and Python packages. A theory is treated as a versioned, machine-checkable object, scored against a twelve-item rigour checklist and connected to the bibliometric literature."
type: software
authors:
  - family-names: Bernabeu
    given-names: Pablo
    orcid: "https://orcid.org/0000-0003-1083-2460"
    email: pcbernabeu@gmail.com
version: "0.6.0"
# The R and Python packages share this version. The date is the day 0.6.0 first
# became public, on PyPI. CRAN published the R package on 2026-09-01.
date-released: "2026-08-27"
# This file describes the repository, which holds both packages, so its DOI is
# Zenodo's concept DOI, which archives every GitHub release of both and favours
# neither. Each package's own citation gives that package's identifier: the R
# package's gives the DOI CRAN assigned to it, and the Python package's gives
# this one, since PyPI assigns no DOI.
doi: "10.5281/zenodo.21229964"
# Each identifier, marked with the package it names. CFF's repository-artifact
# holds a single address, which would favour one distribution, so CRAN and PyPI
# are both listed here instead.
identifiers:
  - type: doi
    value: "10.5281/zenodo.21229964"
    description: "Both packages: every GitHub release of the repository, archived on Zenodo. The Python package's citation gives this DOI."
  - type: doi
    value: "10.32614/CRAN.package.theoryforge"
    description: "The R package: the DOI CRAN assigned to it, across all its versions. The R package's citation gives this DOI."
  - type: url
    value: "https://CRAN.R-project.org/package=theoryforge"
    description: "The R package on CRAN."
  - type: url
    value: "https://pypi.org/project/theoryforge/"
    description: "The Python package on PyPI."
license: MIT
repository-code: "https://github.com/pablobernabeu/theoryforge"
url: "https://pablobernabeu.github.io/theoryforge/"
keywords:
  - theory development
  - metascience
  - falsifiability
  - preregistration
  - reproducible research
