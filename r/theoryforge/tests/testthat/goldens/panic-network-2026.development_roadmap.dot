digraph development_roadmap {
  graph [rankdir=TB, bgcolor="transparent", fontname="Helvetica", fontsize=11, pad="0.2", nodesep="0.3", ranksep="0.45"];
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", color="#33567A", fillcolor="#F2F6F9", fontcolor="#12283A", penwidth=1.1, margin="0.16,0.1"];
  edge [fontname="Helvetica", fontsize=10, color="#7B909F", fontcolor="#0F6E6E", arrowsize=0.7];
  "roadmap" [shape=ellipse, label="Network theory of\npanic disorder\nchecklist 3.1\nchecklist score 88.0, gate pass", fillcolor="#12283A", color="#12283A", fontcolor="#FFFFFF"];
  "derivation_chain" [label="1. derivation_chain\nEvery prediction cites\ndeclared propositions,\nthe causal graph\nentails any claim it\nstates and contradicts\nno phenomenon's claim\n(a claim left unread\nbecause of a feedback\nloop warns)\nadvisory", fillcolor="#FBF1DC", color="#9C6B14"];
  "roadmap" -> "derivation_chain";
  { rank=same; "derivation_chain"; }
}
