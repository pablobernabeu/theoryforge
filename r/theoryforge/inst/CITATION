citHeader("To cite theoryforge in publications, please use:")

# The doi and url fields hold the DOI CRAN assigned on publication and the
# package's canonical CRAN page, the same pair utils::citation() generates for a
# copy installed from CRAN that has no CITATION file. The DOI names the R package
# across all its versions, so the version in the note identifies the release
# cited. Zenodo archives every GitHub release of the repository, which carries
# the Python twin as well (see the About article). CRAN is the publisher: it
# distributes the package and registered the DOI. Every reference the package
# family gives names it alike, in full.
bibentry(
  bibtype = "Manual",
  title   = "{theoryforge}: Systematic theory development",
  author  = person("Pablo", "Bernabeu", comment = c(ORCID = "0000-0003-1083-2460")),
  year    = "2026",
  publisher = "Comprehensive R Archive Network (CRAN)",
  note    = paste("R package version", meta$Version),
  doi     = "10.32614/CRAN.package.theoryforge",
  url     = "https://CRAN.R-project.org/package=theoryforge",
  textVersion = paste0(
    "Bernabeu, P. (2026). theoryforge: Systematic theory development. ",
    "R package version ", meta$Version, ". ",
    "Comprehensive R Archive Network (CRAN). ",
    "https://doi.org/10.32614/CRAN.package.theoryforge"
  )
)
